{
  "pluginAlias": "AndroidTVUltimate",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Pair each television from the AndroidTV Ultimate dashboard. Credentials stay in Homebridge storage and are never written into config.json.",
  "footerDisplay": "Remote Service v2 must be available on TCP ports 6466 and 6467. Wake-on-LAN is optional and is used only when an offline TV is turned on.",
  "schema": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "AndroidTV Ultimate"
      },
      "debug": {
        "title": "Debug Logging",
        "type": "boolean",
        "default": false
      },
      "disconnectGraceMs": {
        "title": "Offline Grace Period",
        "description": "How long to retain the last known state during a brief reconnect.",
        "type": "integer",
        "minimum": 500,
        "maximum": 30000,
        "default": 2500
      },
      "discoveryIntervalSeconds": {
        "title": "mDNS Refresh Interval",
        "description": "How often to refresh cached Android TV IP addresses. Previously discovered TVs remain cached while offline.",
        "type": "integer",
        "minimum": 15,
        "maximum": 3600,
        "default": 60
      },
      "customInputPresets": {
        "title": "My Input Presets",
        "description": "Reusable personal input templates managed by the custom UI. Adding one to a television creates an independent copy.",
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "name"],
          "oneOf": [
            { "required": ["uri"], "not": { "required": ["keyCode"] } },
            { "required": ["keyCode"], "not": { "required": ["uri"] } }
          ],
          "properties": {
            "id": { "title": "Stable Preset ID", "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            "name": { "title": "Name", "type": "string", "minLength": 1 },
            "uri": { "title": "Android TV URI or Package", "type": "string", "minLength": 1 },
            "type": {
              "title": "HomeKit Input Type",
              "type": "string",
              "default": "application",
              "enum": ["application", "home", "tuner", "hdmi", "composite", "svideo", "component", "dvi", "airplay", "usb", "other"]
            },
            "keyCode": { "title": "Android Key Code", "type": "integer", "minimum": 0, "maximum": 1000 },
            "packageName": { "title": "Active Android Package", "type": "string" }
          }
        }
      },
      "devices": {
        "title": "Televisions",
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "name", "host"],
          "properties": {
            "id": {
              "title": "Stable Device ID",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "host": {
              "title": "Host or IP Address",
              "type": "string"
            },
            "discoveryId": {
              "title": "Stable Discovery Identity",
              "description": "Automatically saved from Android TV mDNS metadata, including its advertised hardware identifier.",
              "type": "string"
            },
            "serviceName": {
              "title": "mDNS Service Identity",
              "description": "Automatically saved by network discovery and used to follow IP changes.",
              "type": "string"
            },
            "hostname": {
              "title": "mDNS Hostname",
              "description": "Automatically saved by network discovery.",
              "type": "string"
            },
            "remotePort": {
              "title": "Remote Port",
              "type": "integer",
              "default": 6466,
              "minimum": 1,
              "maximum": 65535
            },
            "pairingPort": {
              "title": "Pairing Port",
              "type": "integer",
              "default": 6467,
              "minimum": 1,
              "maximum": 65535
            },
            "model": {
              "title": "Model",
              "type": "string"
            },
            "manufacturer": {
              "title": "Manufacturer",
              "type": "string"
            },
            "mac": {
              "title": "Wake-on-LAN MAC Address",
              "description": "Optional. Used as a stable discovery identity and to turn on an offline TV.",
              "type": "string",
              "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$"
            },
            "broadcastAddress": {
              "title": "Wake-on-LAN Broadcast Address",
              "type": "string",
              "default": "255.255.255.255"
            },
            "deviceType": {
              "title": "HomeKit Device Type",
              "description": "Controls the exact Apple Home glyph when this TV is exposed as a standalone accessory.",
              "type": "string",
              "default": "television",
              "oneOf": [
                { "title": "Television", "enum": ["television"] },
                { "title": "Set-top Box", "enum": ["settopbox"] },
                { "title": "Streaming Stick", "enum": ["streamingstick"] },
                { "title": "Apple TV", "enum": ["appletv"] },
                { "title": "Audio Receiver", "enum": ["audioreceiver"] },
                { "title": "Speaker", "enum": ["speaker"] },
                { "title": "HomePod", "enum": ["homepod"] }
              ]
            },
            "exposureMode": {
              "title": "Apple Home Exposure",
              "description": "Bridge keeps the TV on the existing Homebridge bridge. Standalone advertises the exact Television or Set-top Box category and must be paired with Apple Home separately.",
              "type": "string",
              "default": "bridged",
              "oneOf": [
                { "title": "Homebridge Bridge", "enum": ["bridged"] },
                { "title": "Standalone Accessory", "enum": ["standalone"] }
              ]
            },
            "controls": {
              "title": "Controls",
              "description": "Enable controls per device and optionally override the Android key code sent for each remote or media action.",
              "type": "object",
              "properties": {
                "power": { "title": "Power", "type": "boolean" },
                "remote": { "title": "Navigation Remote", "type": "boolean" },
                "media": { "title": "Media Controls", "type": "boolean" },
                "volume": { "title": "Volume", "type": "boolean" },
                "mute": { "title": "Mute", "type": "boolean" },
                "inputs": { "title": "Inputs", "type": "boolean" },
                "wakeOnLan": { "title": "Wake-on-LAN", "type": "boolean" },
                "keyMappings": {
                  "title": "Android Key-code Overrides",
                  "type": "object",
                  "properties": {
                    "up": { "title": "Up", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "down": { "title": "Down", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "left": { "title": "Left", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "right": { "title": "Right", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "select": { "title": "Select", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "back": { "title": "Back", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "home": { "title": "Home", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "menu": { "title": "Menu", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "info": { "title": "Information", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "volumeUp": { "title": "Volume Up", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "volumeDown": { "title": "Volume Down", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "playPause": { "title": "Play / Pause", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "play": { "title": "Play", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "pause": { "title": "Pause", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "stop": { "title": "Stop", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "next": { "title": "Next", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "previous": { "title": "Previous", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "rewind": { "title": "Rewind", "type": "integer", "minimum": 0, "maximum": 1000 },
                    "fastForward": { "title": "Fast Forward", "type": "integer", "minimum": 0, "maximum": 1000 }
                  }
                }
              }
            },
            "inputs": {
              "title": "Inputs",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "anyOf": [
                  { "required": ["uri"] },
                  { "required": ["keyCode"] }
                ],
                "properties": {
                  "name": { "title": "Name", "type": "string" },
                  "presetId": {
                    "title": "Input Catalog Preset",
                    "description": "Optional catalog identity used to show local edits and restore catalog defaults. Saved inputs are never updated automatically.",
                    "type": "string"
                  },
                  "customPresetId": {
                    "title": "Personal Input Preset",
                    "description": "Optional personal preset identity used to show local edits and manually reapply saved defaults.",
                    "type": "string"
                  },
                  "uri": { "title": "Android TV URI or Package", "type": "string" },
                  "type": {
                    "title": "HomeKit Input Type",
                    "type": "string",
                    "default": "application",
                    "oneOf": [
                      { "title": "Application", "enum": ["application"] },
                      { "title": "Home Screen", "enum": ["home"] },
                      { "title": "Tuner", "enum": ["tuner"] },
                      { "title": "HDMI", "enum": ["hdmi"] },
                      { "title": "Composite Video", "enum": ["composite"] },
                      { "title": "S-Video", "enum": ["svideo"] },
                      { "title": "Component Video", "enum": ["component"] },
                      { "title": "DVI", "enum": ["dvi"] },
                      { "title": "AirPlay", "enum": ["airplay"] },
                      { "title": "USB", "enum": ["usb"] },
                      { "title": "Other", "enum": ["other"] }
                    ]
                  },
                  "keyCode": {
                    "title": "Android Key Code",
                    "description": "Optional alternative to a URI for hardware or firmware-specific inputs.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "packageName": {
                    "title": "Android Package Name",
                    "description": "Optional foreground package used to reflect this active input in Apple Home. Deep links can be learned automatically.",
                    "type": "string"
                  },
                  "identifier": { "title": "HomeKit Identifier", "type": "integer", "minimum": 1, "maximum": 255 }
                }
              }
            }
          }
        }
      }
    }
  },
  "layout": [
    "name",
    "debug",
    "disconnectGraceMs",
    "discoveryIntervalSeconds",
    {
      "key": "devices",
      "type": "array",
      "buttonText": "Add TV Manually"
    }
  ]
}
